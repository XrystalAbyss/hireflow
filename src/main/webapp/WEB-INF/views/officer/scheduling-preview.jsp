<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Advisory Schedule Preview - HireFlow" />
<c:set var="activeNav" value="officer-scheduling" />
<c:set var="breadcrumbCurrent" value="Schedule Preview" />
<%@ include file="/WEB-INF/views/common/header.jspf" %>

<div style="max-width: 1200px; margin: 2rem auto; padding: 0 1rem;">
    <!-- Navigation Back Link -->
    <div style="margin-bottom: 1rem;">
        <a href="${pageContext.request.contextPath}/officer/scheduling?driveId=<c:out value='${preview.driveId}'/>"
           style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;" id="linkBackToSetup">
            &larr; Back to Scheduling Parameters Setup
        </a>
    </div>

    <!-- Prominent Advisory Notice Banner -->
    <div class="card" style="margin-bottom: 1.5rem; border-left: 6px solid #f59e0b; background: rgba(245, 158, 11, 0.06);">
        <div class="card-body" style="padding: 1.25rem 1.75rem;">
            <div style="display: flex; align-items: flex-start; gap: 1rem;">
                <div style="font-size: 1.75rem;">⚠️</div>
                <div style="flex: 1;">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #b45309; font-weight: 700;">
                            ADVISORY PREVIEW ONLY — NOT CONFIRMED
                        </span>
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">
                            Token: <strong><c:out value="${preview.previewId}"/></strong> • Valid until: <c:out value="${preview.expiresAt}"/>
                        </div>
                    </div>
                    <p style="margin: 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5;">
                        This timetable is an <strong>in-memory proposed simulation</strong> generated by the deterministic GreedyScheduler.
                        <strong>No database appointments have been saved</strong>, and candidate application statuses remain <code>SHORTLISTED</code>.
                        Clicking <strong>Confirm &amp; Publish Timetable</strong> executes Stage 2 transactional schedule publication, locks resources in PostgreSQL,
                        detects any concurrent conflicts, and advances candidate application statuses from <code>SHORTLISTED</code> to <code>SCHEDULED</code>.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Header Metadata Card -->
    <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-body" style="padding: 1.75rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
            <div>
                <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary); text-transform: uppercase;">
                    Target Recruitment Drive
                </span>
                <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-primary); margin: 0.25rem 0 0.5rem;">
                    <c:out value="${preview.jobTitle}"/>
                </h1>
                <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.9rem; color: var(--text-muted); flex-wrap: wrap;">
                    <span>🏢 <strong><c:out value="${preview.companyName}"/></strong> (Drive ID: <code><c:out value="${preview.driveId}"/></code>)</span>
                    <span>•</span>
                    <span>🗓️ <strong><c:out value="${preview.date}"/></strong> (<c:out value="${preview.startTime}"/> - <c:out value="${preview.endTime}"/>)</span>
                    <span>•</span>
                    <span>⏱️ Slot: <strong><c:out value="${preview.durationMinutes}"/>m</strong> (Gap: <c:out value="${preview.bufferMinutes}"/>m)</span>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                <button type="button" class="btn btn-outline" onclick="window.print();" id="btnPrintTimetable">
                    🖨️ Print / Export View
                </button>
                <form method="post" action="${pageContext.request.contextPath}/officer/scheduling/publish" style="display: inline;" id="formPublishSchedule"
                      onsubmit="return confirm('Confirm and publish ${preview.totalScheduled} interview appointments? Confirmed appointments will lock venue resources and update candidate applications to SCHEDULED.');">
                    <input type="hidden" name="csrfToken" value="${csrfToken}" />
                    <input type="hidden" name="previewId" value="<c:out value='${preview.previewId}'/>" />
                    <button type="submit" class="btn btn-primary" id="btnPublishSchedule"
                            ${preview.totalScheduled == 0 ? 'disabled' : ''}
                            title="${preview.totalScheduled == 0 ? 'No feasible appointments to publish' : 'Commit confirmed appointments to database'}">
                        🚀 Confirm &amp; Publish Timetable
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Statistics Overview Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <div class="card metric-card">
            <div class="card-body" style="padding: 1.5rem; text-align: center;">
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">
                    Shortlisted Pool
                </div>
                <div style="font-size: 2.25rem; font-weight: 800; color: var(--primary);" id="statRequested">
                    <c:out value="${preview.totalRequested}"/>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                    Candidates Evaluated
                </div>
            </div>
        </div>

        <div class="card metric-card">
            <div class="card-body" style="padding: 1.5rem; text-align: center;">
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">
                    Proposed Scheduled
                </div>
                <div style="font-size: 2.25rem; font-weight: 800; color: var(--success);" id="statScheduled">
                    <c:out value="${preview.totalScheduled}"/>
                </div>
                <div style="font-size: 0.75rem; color: var(--success); font-weight: 600; margin-top: 0.25rem;">
                    Feasible Interval Slots
                </div>
            </div>
        </div>

        <div class="card metric-card">
            <div class="card-body" style="padding: 1.5rem; text-align: center;">
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">
                    Unscheduled Candidates
                </div>
                <div style="font-size: 2.25rem; font-weight: 800; color: ${preview.totalUnscheduled > 0 ? 'var(--danger)' : 'var(--text-muted)'};" id="statUnscheduled">
                    <c:out value="${preview.totalUnscheduled}"/>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                    Resource Capacity Deficit
                </div>
            </div>
        </div>
    </div>

    <!-- Proposed Timetable Table -->
    <div class="card" style="margin-bottom: 2rem;">
        <div class="card-body" style="padding: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.25rem;">
                        📋 Proposed Interview Timetable
                    </h2>
                    <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">
                        Feasible candidate appointments mapped to interviewer and room resources.
                    </p>
                </div>
                <span class="badge badge-eligible">
                    <c:out value="${preview.totalScheduled}"/> Proposed Appointments
                </span>
            </div>

            <c:choose>
                <c:when test="${not empty preview.proposedSessions}">
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;" id="proposedTimetable">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
                                    <th style="padding: 0.75rem 1rem;">Slot Time</th>
                                    <th style="padding: 0.75rem 1rem;">Proposal Ref</th>
                                    <th style="padding: 0.75rem 1rem;">Candidate / Student</th>
                                    <th style="padding: 0.75rem 1rem;">Interviewer</th>
                                    <th style="padding: 0.75rem 1rem;">Room / Venue</th>
                                    <th style="padding: 0.75rem 1rem;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <c:forEach var="sessionItem" items="${preview.proposedSessions}">
                                    <tr style="border-bottom: 1px solid var(--border-color);">
                                        <td style="padding: 0.75rem 1rem; font-weight: 700; color: var(--text-primary); white-space: nowrap;">
                                            🕒 <c:out value="${sessionItem.startTime.toLocalTime()}"/> – <c:out value="${sessionItem.endTime.toLocalTime()}"/>
                                        </td>
                                        <td style="padding: 0.75rem 1rem; font-family: monospace; color: var(--text-muted); font-size: 0.8rem;">
                                            <c:out value="${sessionItem.sessionId}"/>
                                        </td>
                                        <td style="padding: 0.75rem 1rem;">
                                            <div style="font-weight: 600; color: var(--text-primary);">
                                                <c:out value="${sessionItem.studentName}"/>
                                            </div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">
                                                <code><c:out value="${sessionItem.studentId}"/></code> • Branch: <c:out value="${sessionItem.studentBranch}"/>
                                            </div>
                                        </td>
                                        <td style="padding: 0.75rem 1rem;">
                                            <div style="font-weight: 500; color: var(--text-secondary);">
                                                🧑‍💼 <c:out value="${sessionItem.interviewerName}"/>
                                            </div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">
                                                <c:out value="${sessionItem.interviewerId}"/>
                                            </div>
                                        </td>
                                        <td style="padding: 0.75rem 1rem;">
                                            <div style="font-weight: 500; color: var(--text-secondary);">
                                                🚪 <c:out value="${sessionItem.roomName}"/>
                                            </div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">
                                                <c:out value="${sessionItem.roomId}"/>
                                            </div>
                                        </td>
                                        <td style="padding: 0.75rem 1rem;">
                                            <span class="badge" style="background: rgba(59, 130, 246, 0.1); color: var(--primary); font-size: 0.75rem; font-weight: 600;">
                                                PROPOSED
                                            </span>
                                        </td>
                                    </tr>
                                </c:forEach>
                            </tbody>
                        </table>
                    </div>
                </c:when>
                <c:otherwise>
                    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                        <div style="font-size: 2.5rem; margin-bottom: 1rem;">⚠️</div>
                        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--danger); margin-bottom: 0.5rem;">
                            No Feasible Appointments Could Be Scheduled
                        </h3>
                        <p style="font-size: 0.9rem; margin-bottom: 1rem;">
                            The GreedyScheduler could not find conflict-free intervals matching the candidate pool and resource constraints.
                            Review the unscheduled explanations below or expand the scheduling window.
                        </p>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>

    <!-- Unscheduled Candidates Table (if any) -->
    <c:if test="${not empty preview.unscheduledCandidates}">
        <div class="card" style="margin-bottom: 2rem; border-left: 4px solid var(--danger);">
            <div class="card-body" style="padding: 1.75rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                    <div>
                        <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--danger); margin: 0 0 0.25rem;">
                            ⚠️ Unscheduled Candidates &amp; Conflict Explanations
                        </h2>
                        <p style="color: var(--text-muted); font-size: 0.875rem; margin: 0;">
                            Candidates who could not be accommodated due to time window boundaries or resource occupancy conflicts.
                        </p>
                    </div>
                    <span class="badge badge-ineligible">
                        <c:out value="${preview.totalUnscheduled}"/> Unscheduled
                    </span>
                </div>

                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;" id="unscheduledTable">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
                                <th style="padding: 0.75rem 1rem;">Application ID</th>
                                <th style="padding: 0.75rem 1rem;">Candidate / Student</th>
                                <th style="padding: 0.75rem 1rem;">Department</th>
                                <th style="padding: 0.75rem 1rem;">Explanation / Conflict Diagnostic</th>
                            </tr>
                        </thead>
                        <tbody>
                            <c:forEach var="unItem" items="${preview.unscheduledCandidates}">
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td style="padding: 0.75rem 1rem; font-family: monospace; font-weight: 600; color: var(--primary);">
                                        <c:out value="${unItem.applicationId}"/>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; font-weight: 600; color: var(--text-primary);">
                                        <c:out value="${unItem.studentName}"/>
                                        <span style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">(<c:out value="${unItem.studentId}"/>)</span>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; color: var(--text-secondary);">
                                        <c:out value="${unItem.studentBranch}"/>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; color: var(--danger); font-size: 0.85rem;">
                                        ⚠️ <c:out value="${unItem.reason}"/>
                                    </td>
                                </tr>
                            </c:forEach>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </c:if>
</div>

<%@ include file="/WEB-INF/views/common/footer.jspf" %>
